{
  "name": "tabletop",
  "version": "0.0.1",
  "description": "AI-driven cybersecurity tabletop exercises for regulated mid-market firms.",
  "keywords": [
    "cli",
    "cybersecurity",
    "incident-response",
    "mitre-attack",
    "nist",
    "tabletop",
    "training"
  ],
  "license": "MIT",
  "bin": {
    "tabletop": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "scenarios",
    "README.md"
  ],
  "type": "module",
