{
  "name": "verdict",
  "version": "0.0.1",
  "description": "Solo open-source maintainers: triage incoming PRs with structured reasoning. Local-first. Every verdict is a labeled training datum.",
  "keywords": [
    "ai",
    "cli",
    "code-review",
    "fine-tuning",
    "open-source",
    "pull-requests",
    "training-data"
  ],
  "license": "MIT",
  "bin": {
    "verdict": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  }
}
