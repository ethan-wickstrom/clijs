{
  "name": "golf",
  "version": "0.0.1",
  "description": "A daily code-golf puzzle for your terminal: solve, submit, shrink your bytes.",
  "keywords": [
    "cli",
    "code-golf",
    "game",
    "puzzle",
    "terminal"
  ],
  "license": "MIT",
